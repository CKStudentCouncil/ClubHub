{
    "tabWidth": 4,
    "printWidth": 120,
    "trailingComma": "es5",
    "plugins": ["prettier-plugin-astro"],
    "overrides": [
        {
            "files": "*.astro",
            "options": { "parser": "astro", "tabWidth": 2 }
        },
        {
            "files": ["*.md", "*.yaml", "*.yml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
