---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

import ClubDetail from "@/components/views/ClubDetail.astro";
import { clubMappings } from "@data/clubFair";
import { clubUrl, CURRENT_CLUB_YEAR } from "@data/clubYears";

export async function getStaticPaths() {
  const clubs = await getCollection("clubs");
  return clubs.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post: CollectionEntry<"clubs"> | undefined = await getEntry("clubs", slug);

if (post === undefined) {
  return Astro.redirect("/404");
}

const { data } = post;
const stampId = clubMappings[data.clubCode] ? clubMappings[data.clubCode].stampId || null : null;

// 只有在封存年度也找得到同一社團時，才提供切換連結
const archived = await getCollection("clubs2025", ({ data: d }) => d.clubCode === data.clubCode);
const hrefs = {
  [CURRENT_CLUB_YEAR.year]: clubUrl(CURRENT_CLUB_YEAR.year, post.slug),
  2025: archived[0] ? clubUrl(2025, archived[0].slug) : undefined,
};

const cleanSummary = data.summary.replace(/\s+/g, " ").trim();

const schema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: data.name,
  description: cleanSummary,
  alternateName: data.alternateNames || [],
  url: Astro.url.href,
};
---

<Layout
  title={`${data.name} | CKClubHub 建中社團資料庫`}
  description={data.summary}
  customOgTitle={`查看 建中${data.name} 在 CKClubHub 建中社團資料庫上的專屬頁面`}
  customOgImage={data.profileImage}
  customOgDescription={cleanSummary.slice(0, 30) + "..."}
  structuredData={schema}
  padding={false}
>
  <ClubDetail post={post} year={CURRENT_CLUB_YEAR.year} stampId={stampId} hrefs={hrefs} />
</Layout>
